# Copy to .env; never commit real provider credentials.
PORT=8000
NODE_ENV=development
PROVIDER_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_PROMPT_LENGTH=12000

# OpenRouter uses its provider-reported model catalogue for free-priced models.
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=GMS Suite AI

# Optional Gemini provider. Check Google's current pricing/quota for your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash
# Only list models here after verifying they are free for your account.
GEMINI_FREE_MODELS=
# Optional, disabled by default; free OpenRouter candidates may be tried after Gemini errors.
GEMINI_FALLBACK_ENABLED=false
