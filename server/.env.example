# Copy to .env; never commit real provider credentials.
PORT=8000
NODE_ENV=development
PROVIDER_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_PROMPT_LENGTH=12000

# OpenRouter uses its provider-reported model catalogue for free-priced models.
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=GMS Suite AI

# Optional Gemini provider. Model options are filtered against the live API catalogue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_MODELS=
GEMINI_FALLBACK_ENABLED=false

# Optional LangChain Deep Agents sidecar. Keep disabled by default.
ENABLE_DEEP_AGENTS=false
DEEP_AGENTS_URL=http://127.0.0.1:8010
DEEP_AGENTS_SHARED_TOKEN=
DEEP_AGENTS_TIMEOUT_MS=50000
DEEP_AGENTS_PROVIDER=openrouter
DEEP_AGENTS_OPENROUTER_MODEL=openrouter/free
DEEP_AGENTS_GEMINI_MODEL=gemini-2.5-flash
