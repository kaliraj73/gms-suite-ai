# Copy to .env; never commit real provider credentials.
PORT=8000
NODE_ENV=development
PROVIDER_TIMEOUT_MS=25000
MODEL_CACHE_TTL_MS=60000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
MAX_PROMPT_LENGTH=12000

# OpenRouter uses provider-reported model prices; HTTP 401 normally means invalid, revoked,
# or incorrectly loaded credentials. Never put API keys into frontend VITE_* variables.
OPENROUTER_API_KEY=
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_TITLE=GMS Suite AI

# Model IDs are discovered live from Google's models API. This is the default chat selection.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Only label a Gemini model free after verifying your account's actual quota/pricing.
GEMINI_FREE_MODELS=
GEMINI_FALLBACK_ENABLED=false

# Optional when another service already occupies port 8000; expose this port in Cloud Shell.
# PORT=8002
